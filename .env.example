# Copy to .env and fill in. The pipeline, metrics and tests work WITHOUT any key.
# Only the Claude-backed natural-language parser needs ANTHROPIC_API_KEY.

# Leave empty to use the offline rule-based parser
ANTHROPIC_API_KEY=

# auto = Claude if a key is set, otherwise rules | claude | rules
NL_BACKEND=auto

# Model used for question understanding (configurable; any current Claude model works)
ANTHROPIC_MODEL=claude-haiku-5-5

# Answers below this confidence are refused instead of guessed (0-1)
NL_MIN_CONFIDENCE=0.6

# Optional: where the SQLite database is written
# DB_PATH=data/placement.db
